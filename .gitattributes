# ============================================================================
# 行尾纪律（项目铁律：文本文件一律纯 LF，禁 CRLF）
# 起因：本机 git 全局 core.autocrlf=true，会把仓库里的 LF 检出成 CRLF。
#       显式 eol=lf 可覆盖它，保证编辑器/脚本读到的是 LF。
# ============================================================================
# 默认：所有被判定为文本的文件，进库与检出都用 LF
* text=auto eol=lf

*.c            text eol=lf
*.h            text eol=lf
*.cpp          text eol=lf
*.s            text eol=lf
*.icf          text eol=lf
*.py           text eol=lf
*.sh           text eol=lf
*.cmd          text eol=lf
*.md           text eol=lf
*.txt          text eol=lf
*.csv          text eol=lf
*.json         text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.ioc          text eol=lf
*.cmake        text eol=lf
CMakeLists.txt text eol=lf
*.ewp          text eol=lf
*.ewd          text eol=lf
*.ewt          text eol=lf
*.eww          text eol=lf
*.code-workspace text eol=lf
*.cs           text eol=lf

# 自身也必须是 LF，否则每轮 git add 都会报 "will be replaced by CRLF"
.gitattributes text eol=lf
.gitignore     text eol=lf

# --- 二进制（明确声明，避免被 text=auto 误判后差异爆炸） ---
*.hex   binary
*.elf   binary
*.bin   binary
*.a     binary
*.o     binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.wav   binary
*.mp3   binary
*.zip   binary
*.7z    binary
