# dot files
/.vscode/launch.json
/.settings
/.eide/log
/.eide.usr.ctx.json

# project out
/build
/bin
/obj
/out
/EWARM/settings
# 🛑 2026-11-03：EIDE 工程目录不能整目录排除 —— `.eide/eide.yml` 才是**真实构建定义**
# （srcDirs: [] 逐条枚举源文件，`.ewp` 反而缺 ecg_crc8.c / fast_restore_snippet.c）。
# 整目录排除 ⇒ 克隆下来无法重建工程。故改为：排内容、留 eide.yml。
# env.ini 含本机绝对路径（PROJ_PATH），属机器本地态，继续忽略。
/EWARM/demo_ads1293/*
!/EWARM/demo_ads1293/.eide/
/EWARM/demo_ads1293/.eide/*
!/EWARM/demo_ads1293/.eide/eide.yml
!/EWARM/demo_ads1293/.eide/files.options.yml
# 🛑 2026-11-03 猛哥拍板：第三方库与大文件**不推远端仓库**。
#   理由：Drivers 单目录 96 MB（其中 CMSIS/DSP 46 MB 预编译 .a/.lib、CMSIS/Device 35 MB
#   含 20+ 个 L4 型号头），入库会把仓库从 2.87 MB 顶到 56 MB，而这些都能从
#   STM32Cube FW_L4 包重建。
#   ⚠ 代价（已知并接受）：**clone 下来不能直接构建**，需自备下列目录。
#   📌 补齐清单、验收条件、以及「USB_DEVICE 其实只有 72 KB 且含本项目自有代码
#      usbd_cdc_if.c，将来独立分发时应优先补入」这条例外，全部记在
#      **README.md §7「不入库的依赖」** —— 动这三条之前先读那一节。
/Drivers
/Middlewares
/USB_DEVICE
#/tools
/tools/*.txt

# tools 下自检工程（C#/.NET）的构建产物 —— 可再生，不入库（2026-10-08）
# ⚠ 只忽略 bin/obj，不动 tools/_tNNN/ 下的源码、数据与 .blk 等产物
/tools/**/bin/
/tools/**/obj/

# eide template
*.ept
*.eide-template
*.ioc
.mxproject

# Python 字节码缓存（2026-11-03 补：此前 __pycache__/*.pyc 被误入库）
__pycache__/
*.pyc

# 项目记忆/会话数据（跟随工程，不进版本库）
/.workbuddy/
